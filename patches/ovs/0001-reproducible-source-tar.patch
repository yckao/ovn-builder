From: ovn-builder <noreply@example.invalid>
Subject: [PATCH] debian: make the embedded source tar deterministic

Automake's dist target otherwise preserves wall-clock mtimes on directories
and files generated by dh_autoreconf.  Scope GNU tar normalization to the
source-distribution command so openvswitch-source is reproducible without
changing extraction or the rest of the Debian package build.
---
 debian/rules | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/debian/rules b/debian/rules
index 51d8fe000..c6ff1f000 100755
--- a/debian/rules
+++ b/debian/rules
@@ -89,8 +89,11 @@ pybuild = \
 	extra_libs="-Wl,-Bstatic -lopenvswitch -Wl,-Bdynamic `pkg-config --libs --static libopenvswitch`" \
 	pybuild
 
+REPRODUCIBLE_TAR_OPTIONS = --sort=name --mtime=@$(SOURCE_DATE_EPOCH) --owner=0 --group=0 --numeric-owner --pax-option=delete=atime,delete=ctime
+
 override_dh_auto_build:
-	dh_auto_build --sourcedirectory=_debian -- dist distdir=openvswitch
+	env TAR_OPTIONS='$(REPRODUCIBLE_TAR_OPTIONS)' \
+		dh_auto_build --sourcedirectory=_debian -- dist distdir=openvswitch
 	dh_auto_build --sourcedirectory=_debian
 	# We need an extra install here so that we can use pkgconfig to
 	# retrieve accurate CFLAGS and LDFLAGS for building Python extensions.
--
2.43.0
